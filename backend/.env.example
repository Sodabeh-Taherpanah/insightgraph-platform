# NestJS backend. It reads real environment variables and does not load .env files.
PORT=3001
ES_NODE=http://localhost:9200
ES_INDEX=insightgraph
LLM_SERVICE_URL=http://127.0.0.1:8000
# Optional cache. If Redis is unreachable the backend runs without caching.
REDIS_URL=redis://localhost:6379
# Optional. When set, triplet extraction and summaries use OpenAI (gpt-4o-mini);
# when empty, a simple heuristic fallback is used.
OPENAI_API_KEY=
# Experiment switches for the latency test (marked TEMP in the code).
# CONTEXT_CHUNKS: chunks sent to the model (default 3).
# CONTEXT_ORDER: "score" (default) or "index" (order chunks by position in the document).
# CONTEXT_CHUNKS=3
# CONTEXT_ORDER=score
