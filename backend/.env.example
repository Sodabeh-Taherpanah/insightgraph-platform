# NestJS backend (src/main.ts, services/*, controllers/documents.controller.ts)
PORT=3001
ES_NODE=http://localhost:9200
ES_INDEX=insightgraph
LLM_SERVICE_URL=http://127.0.0.1:8000
# Optional cache. If Redis is unreachable the backend runs without caching.
REDIS_URL=redis://localhost:6379
# Optional. When set, triplet extraction and summaries use OpenAI (gpt-4o-mini);
# when empty, a simple heuristic fallback is used.
OPENAI_API_KEY=
